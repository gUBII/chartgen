datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AmountEaten {
  ZERO
  TWENTY_FIVE
  FIFTY
  SEVENTY_FIVE
  ONE_HUNDRED
  REFUSED
}

enum SwallowObservation {
  NONE
  COUGHING
  GAGGING
  CHOKING
  WATERY_EYES
  MULTIPLE_SWALLOWS
  THROAT_CLEARING
}

enum MARStatus {
  ADMINISTERED
  REFUSED
  HELD
}

enum StaffRole {
  SUPPORT_WORKER
  SUPERVISOR
  CLINICAL_LEAD
}

enum EntrySource {
  LIVE
  RESTORED_APPROVED
  SYNTHETIC_QA
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CANDIDATE_CREATED
  CANDIDATE_APPROVED
  CANDIDATE_REJECTED
  LEDGER_WRITTEN
}

model Participant {
  id                    String  @id @default(uuid())
  externalReference     String? @unique
  fullName              String
  defaultFoodTexture    Int
  defaultFluidThickness Int

  mealLogs           MealLog[]
  marLogs            MARLog[]
  bglLogs            BglLog[]
  sleepSettlingLogs  SleepSettlingLog[]
  bowelFluidLogs     BowelFluidLog[]
  personalCareLogs   PersonalCareLog[]
  communityAccessLogs CommunityAccessLog[]
  repositioningLogs  RepositioningLog[]
  incidents          Incident[]
  incidentNotifications IncidentNotification[]
  restrictivePracticeEvents RestrictivePracticeEvent[]
  monthlyReports     MonthlyReport[]
  highIntensityEvents HighIntensityEventLog[]
  trainingRecords    TrainingRecord[]
  seizureEvents      SeizureEvent[]
  shiftNotes         ShiftNote[]
  goalProgress       GoalProgress[]
  recordCorrections  RecordCorrection[]
  bglDiabetesLogs    BglDiabetesLog[]
  sleepSettlingQaLogs SleepSettlingQaLog[]
  bowelFluidQaLogs   BowelFluidQaLog[]
  hygieneLogs        HygieneLog[]
  communityAccessQaLogs CommunityAccessQaLog[]
  repositioningQaLogs RepositioningQaLog[]
  restorationBatches RestorationBatch[]
  mealCandidates     RestoredMealCandidate[]
  marCandidates      RestoredMARCandidate[]
  auditEvents        AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id           String    @id @default(uuid())
  workerNumber String    @unique
  displayName  String
  role         StaffRole

  createdMealLogs             MealLog[]               @relation("MealCreatedBy")
  approvedMealLogs            MealLog[]               @relation("MealApprovedBy")
  createdMARLogs              MARLog[]                @relation("MARCreatedBy")
  approvedMARLogs             MARLog[]                @relation("MARApprovedBy")
  loggedBgls                  BglLog[]                @relation("BglLoggedBy")
  loggedSleepSettling         SleepSettlingLog[]      @relation("SleepLoggedBy")
  loggedBowelFluid            BowelFluidLog[]         @relation("BowelFluidLoggedBy")
  loggedPersonalCare          PersonalCareLog[]       @relation("PersonalCareLoggedBy")
  loggedCommunityAccess       CommunityAccessLog[]    @relation("CommunityAccessLoggedBy")
  loggedRepositioning         RepositioningLog[]      @relation("RepositioningLoggedBy")
  reportedIncidents           Incident[]              @relation("IncidentReportedBy")
  incidentNotifications       IncidentNotification[]  @relation("IncidentNotifiedBy")
  restrictivePracticeEvents   RestrictivePracticeEvent[] @relation("RestrictivePracticeLoggedBy")
  monthlyReports              MonthlyReport[]         @relation("MonthlyReportCompiledBy")
  highIntensityEvents         HighIntensityEventLog[] @relation("HighIntensityLoggedBy")
  trainingRecords             TrainingRecord[]        @relation("TrainingRecordedBy")
  seizureEvents               SeizureEvent[]          @relation("SeizureLoggedBy")
  shiftNotes                  ShiftNote[]             @relation("ShiftNoteAuthoredBy")
  goalProgressEntries         GoalProgress[]          @relation("GoalProgressRecordedBy")
  recordCorrections           RecordCorrection[]      @relation("RecordCorrectionBy")
  bglDiabetesLogs             BglDiabetesLog[]        @relation("BglDiabetesLoggedBy")
  sleepSettlingQaLogs         SleepSettlingQaLog[]    @relation("SleepSettlingQaLoggedBy")
  bowelFluidQaLogs            BowelFluidQaLog[]       @relation("BowelFluidQaLoggedBy")
  hygieneLogs                 HygieneLog[]            @relation("HygieneLoggedBy")
  communityAccessQaLogs       CommunityAccessQaLog[]  @relation("CommunityAccessQaLoggedBy")
  repositioningQaLogs         RepositioningQaLog[]    @relation("RepositioningQaLoggedBy")
  requestedRestorationBatches RestorationBatch[]      @relation("BatchRequestedBy")
  reviewedRestorationBatches  RestorationBatch[]      @relation("BatchReviewedBy")
  generatedMealCandidates     RestoredMealCandidate[] @relation("MealCandidateGeneratedBy")
  reviewedMealCandidates      RestoredMealCandidate[] @relation("MealCandidateReviewedBy")
  generatedMARCandidates      RestoredMARCandidate[]  @relation("MARCandidateGeneratedBy")
  reviewedMARCandidates       RestoredMARCandidate[]  @relation("MARCandidateReviewedBy")
  auditEvents                 AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestorationBatch {
  id                 String          @id @default(uuid())
  participantId      String
  participant        Participant     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  requestedByStaffId String
  requestedByStaff   Staff           @relation("BatchRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: Restrict)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?          @relation("BatchReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reason             String
  recoveryStart      DateTime
  recoveryEnd        DateTime
  status             CandidateStatus @default(PENDING)

  mealCandidates RestoredMealCandidate[]
  marCandidates  RestoredMARCandidate[]
  mealLogs       MealLog[]
  marLogs        MARLog[]

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([participantId, recoveryStart, recoveryEnd])
  @@index([status, createdAt])
}

model RestoredMealCandidate {
  id                     String               @id @default(uuid())
  restorationBatchId     String
  restorationBatch       RestorationBatch     @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId     String
  generatedByStaff       Staff                @relation("MealCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  status                 CandidateStatus      @default(PENDING)
  reviewedByStaffId      String?
  reviewedByStaff        Staff?               @relation("MealCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment          String?
  reviewedAt             DateTime?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([status, createdAt])
}

model RestoredMARCandidate {
  id                 String           @id @default(uuid())
  restorationBatchId String
  restorationBatch   RestorationBatch @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId String
  generatedByStaff   Staff            @relation("MARCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  statusComment      String?
  statusReview       CandidateStatus  @default(PENDING)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?           @relation("MARCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment      String?
  reviewedAt         DateTime?
  provenanceHash     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([statusReview, createdAt])
}

model MealLog {
  id                     String               @id @default(uuid())
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId       String
  createdByStaff         Staff                @relation("MealCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId      String?
  approvedByStaff        Staff?               @relation("MealApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId     String?
  restorationBatch       RestorationBatch?    @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source                 EntrySource          @default(LIVE)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([source, timestamp])
}

model MARLog {
  id                 String            @id @default(uuid())
  participantId      String
  participant        Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId   String
  createdByStaff     Staff             @relation("MARCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId  String?
  approvedByStaff    Staff?            @relation("MARApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId String?
  restorationBatch   RestorationBatch? @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source             EntrySource       @default(LIVE)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  provenanceHash     String
  linkedBglLogs      BglLog[]                @relation("BglLinkedMar")
  restrictivePracticeEvents RestrictivePracticeEvent[] @relation("RestrictivePracticeLinkedMar")
  seizureEvents      SeizureEvent[]          @relation("SeizureLinkedMar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([source, status, scheduledAdminTime])
}

enum SleepStatus {
  ASLEEP
  AWAKE
  AGITATED
}

enum BowelFluidType {
  BOWEL
  FLUID_IN
  FLUID_OUT
}

enum SkinIntegrityStatus {
  INTACT
  REDNESS
  BROKEN
}

enum RepositioningPosition {
  LEFT
  RIGHT
  SUPINE
  SEATED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum RestrictivePracticeType {
  CHEMICAL
  PHYSICAL
  MECHANICAL
  ENVIRONMENTAL
}

enum HighIntensityType {
  COMPLEX_BOWEL_CARE
  ENTERAL_FEEDING
  RESPIRATORY_SUPPORT
  EPILEPSY_SUPPORT
}

enum TrainingStatus {
  CURRENT
  EXPIRED
  PENDING
}

enum SeizureType {
  FOCAL
  GENERALIZED
  UNKNOWN
}

enum ShiftNoteCategory {
  ROUTINE
  ESCALATION
  INCIDENT_FOLLOWUP
  CLINICAL_HANDOVER
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum CorrectionReason {
  TRANSCRIPTION_ERROR
  MISSING_INFORMATION
  CLINICAL_AMENDMENT
  AUDIT_REMEDIATION
}

enum DataSource {
  SYNTHETIC_QA
  PRODUCTION
}

enum QaSeverity {
  NONE
  INFO
  WARN
  ERROR
  CRITICAL
}

enum FastingStatus {
  FASTING
  NON_FASTING
  UNKNOWN
}

enum QaSleepStatus {
  ASLEEP
  AWAKE
  AGITATED
  OUT_OF_BED
}

enum SleepIntervention {
  NONE
  VERBAL_PROMPT
  REDIRECTION
  CPAP_CHECK
  CONTINENCE_AID_CHANGE
  COMFORT_MEASURES
  OTHER
}

enum BristolScale {
  S1
  S2
  S3
  S4
  S5
  S6
  S7
}

enum StoolSize {
  SMALL
  MEDIUM
  LARGE
}

enum CompletionStatus {
  COMPLETED
  PARTIAL
  REFUSED
  NOT_APPLICABLE
  UNKNOWN
}

enum CommunityPurpose {
  SOCIAL
  MEDICAL
  CAPACITY_BUILDING
  OTHER
}

enum TransportMethod {
  WALK
  PUBLIC_TRANSPORT
  TAXI_RIDESHARE
  PROVIDER_VEHICLE
  PRIVATE_VEHICLE
  OTHER
}

enum RepositionPosition {
  LEFT_SIDE
  RIGHT_SIDE
  SUPINE
  PRONE
  SEATED
  TILT_IN_SPACE
  OTHER
}

enum SkinCheckOutcome {
  INTACT
  REDNESS
  BREAKDOWN
  PAIN
  REQUIRES_ESCALATION
  UNKNOWN
  OTHER
}

model BglLog {
  id             String      @id @default(uuid())
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff  Staff       @relation("BglLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  linkedMarLogId String?
  linkedMarLog   MARLog?     @relation("BglLinkedMar", fields: [linkedMarLogId], references: [id], onDelete: SetNull)
  reading        Float
  fasting        Boolean
  actionTaken    String
  source         EntrySource @default(LIVE)
  shiftNotes     ShiftNote[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([participantId, createdAt])
  @@index([source, createdAt])
}

model SleepSettlingLog {
  id              String      @id @default(uuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff   Staff       @relation("SleepLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  checkTime       DateTime
  status          SleepStatus
  intervention    String?
  source          EntrySource @default(LIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([participantId, checkTime])
  @@index([source, checkTime])
}

model BowelFluidLog {
  id               String         @id @default(uuid())
  participantId    String
  participant      Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId  String
  loggedByStaff    Staff          @relation("BowelFluidLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  type             BowelFluidType
  bristolScale     Int?
  volumeMl         Int?
  source           EntrySource    @default(LIVE)
  highIntensityEvents HighIntensityEventLog[] @relation("HighIntensityLinkedBowelFluid")
  shiftNotes       ShiftNote[]       @relation("ShiftNoteBowelFluidLink")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([participantId, createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
}

model PersonalCareLog {
  id               String              @id @default(uuid())
  participantId    String
  participant      Participant         @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId  String
  loggedByStaff    Staff               @relation("PersonalCareLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  shower           Boolean
  oralCare         Boolean
  skinIntegrity    SkinIntegrityStatus
  refusalReason    String?
  source           EntrySource         @default(LIVE)
  shiftNotes       ShiftNote[]         @relation("ShiftNotePersonalCareLink")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([participantId, createdAt])
  @@index([source, createdAt])
}

model CommunityAccessLog {
  id               String      @id @default(uuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId  String
  loggedByStaff    Staff       @relation("CommunityAccessLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  destination      String
  purpose          String
  durationMin      Int
  odometerStart    Int?
  odometerEnd      Int?
  source           EntrySource @default(LIVE)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([participantId, createdAt])
  @@index([source, createdAt])
}

model RepositioningLog {
  id               String               @id @default(uuid())
  participantId    String
  participant      Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId  String
  loggedByStaff    Staff                @relation("RepositioningLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  position         RepositioningPosition
  skinCheckOutcome String
  source           EntrySource          @default(LIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([participantId, createdAt])
  @@index([source, createdAt])
}

model Incident {
  id                String           @id @default(uuid())
  participantId     String
  participant       Participant      @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reportedByStaffId String
  reportedByStaff   Staff            @relation("IncidentReportedBy", fields: [reportedByStaffId], references: [id], onDelete: Restrict)
  severity          IncidentSeverity
  description       String
  status            IncidentStatus   @default(OPEN)
  source            EntrySource      @default(LIVE)
  notifications     IncidentNotification[]
  restrictivePracticeEvents RestrictivePracticeEvent[]
  shiftNotes        ShiftNote[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([participantId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
}

model IncidentNotification {
  id                String      @id @default(uuid())
  incidentId        String
  incident          Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  participantId     String
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  notifiedByStaffId String
  notifiedByStaff   Staff       @relation("IncidentNotifiedBy", fields: [notifiedByStaffId], references: [id], onDelete: Restrict)
  method            String
  recipient         String
  sentAt            DateTime
  source            EntrySource @default(LIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([incidentId, sentAt])
  @@index([participantId, sentAt])
}

model RestrictivePracticeEvent {
  id                String                   @id @default(uuid())
  participantId     String
  participant       Participant              @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId   String
  loggedByStaff     Staff                    @relation("RestrictivePracticeLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  incidentId        String?
  incident          Incident?                @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  relatedMarLogId   String?
  relatedMarLog     MARLog?                  @relation("RestrictivePracticeLinkedMar", fields: [relatedMarLogId], references: [id], onDelete: SetNull)
  type              RestrictivePracticeType
  reason            String
  durationMin       Int?
  source            EntrySource              @default(LIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([participantId, createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
}

model MonthlyReport {
  id                 String      @id @default(uuid())
  participantId      String
  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  compiledByStaffId  String
  compiledByStaff    Staff       @relation("MonthlyReportCompiledBy", fields: [compiledByStaffId], references: [id], onDelete: Restrict)
  monthStart         DateTime
  monthEnd           DateTime
  summary            String
  totalIncidents     Int         @default(0)
  totalRestrictiveEvents Int     @default(0)
  source             EntrySource @default(LIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([participantId, monthStart, monthEnd])
}

model HighIntensityEventLog {
  id                  String            @id @default(uuid())
  participantId       String
  participant         Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId     String
  loggedByStaff       Staff             @relation("HighIntensityLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  type                HighIntensityType
  details             String
  linkedBowelFluidLogId String?
  linkedBowelFluidLog BowelFluidLog?   @relation("HighIntensityLinkedBowelFluid", fields: [linkedBowelFluidLogId], references: [id], onDelete: SetNull)
  source              EntrySource       @default(LIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([participantId, createdAt])
  @@index([type, createdAt])
}

model TrainingRecord {
  id                 String         @id @default(uuid())
  participantId      String
  participant        Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  staffId            String
  staff              Staff          @relation("TrainingRecordedBy", fields: [staffId], references: [id], onDelete: Restrict)
  competency         HighIntensityType
  status             TrainingStatus
  validUntil         DateTime?
  source             EntrySource    @default(LIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([participantId, competency, status])
  @@index([staffId, competency, status])
}

model SeizureEvent {
  id                String       @id @default(uuid())
  participantId     String
  participant       Participant  @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId   String
  loggedByStaff     Staff        @relation("SeizureLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  type              SeizureType
  onsetAt           DateTime
  durationSec       Int?
  relatedMarLogId   String?
  relatedMarLog     MARLog?      @relation("SeizureLinkedMar", fields: [relatedMarLogId], references: [id], onDelete: SetNull)
  intervention      String?
  source            EntrySource  @default(LIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([participantId, onsetAt])
  @@index([source, onsetAt])
}

model ShiftNote {
  id                 String            @id @default(uuid())
  participantId      String
  participant        Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authoredByStaffId  String
  authoredByStaff    Staff             @relation("ShiftNoteAuthoredBy", fields: [authoredByStaffId], references: [id], onDelete: Restrict)
  category           ShiftNoteCategory @default(ROUTINE)
  note               String
  linkedPersonalCareLogId String?
  linkedPersonalCareLog PersonalCareLog? @relation("ShiftNotePersonalCareLink", fields: [linkedPersonalCareLogId], references: [id], onDelete: SetNull)
  linkedIncidentId   String?
  linkedIncident     Incident?         @relation(fields: [linkedIncidentId], references: [id], onDelete: SetNull)
  linkedBglLogId     String?
  linkedBglLog       BglLog?           @relation(fields: [linkedBglLogId], references: [id], onDelete: SetNull)
  linkedBowelFluidLogId String?
  linkedBowelFluidLog BowelFluidLog? @relation("ShiftNoteBowelFluidLink", fields: [linkedBowelFluidLogId], references: [id], onDelete: SetNull)
  source             EntrySource       @default(LIVE)
  goalProgress       GoalProgress[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([participantId, createdAt])
  @@index([category, createdAt])
  @@index([source, createdAt])
}

model GoalProgress {
  id                 String      @id @default(uuid())
  participantId      String
  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  recordedByStaffId  String
  recordedByStaff    Staff       @relation("GoalProgressRecordedBy", fields: [recordedByStaffId], references: [id], onDelete: Restrict)
  shiftNoteId        String?
  shiftNote          ShiftNote?  @relation(fields: [shiftNoteId], references: [id], onDelete: SetNull)
  goalName           String
  status             GoalStatus
  progressNote       String?
  source             EntrySource @default(LIVE)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([participantId, goalName, createdAt])
}

model RecordCorrection {
  id                 String         @id @default(uuid())
  participantId      String
  participant        Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  correctedByStaffId String
  correctedByStaff   Staff          @relation("RecordCorrectionBy", fields: [correctedByStaffId], references: [id], onDelete: Restrict)
  auditEventId       String?
  auditEvent         AuditEvent?    @relation(fields: [auditEventId], references: [id], onDelete: SetNull)
  entityType         String
  entityId           String
  reason             CorrectionReason
  beforeHash         String
  afterHash          String
  source             EntrySource    @default(LIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([participantId, createdAt])
  @@index([entityType, entityId, createdAt])
}

