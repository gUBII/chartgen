datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AmountEaten {
  ZERO
  TWENTY_FIVE
  FIFTY
  SEVENTY_FIVE
  ONE_HUNDRED
  REFUSED
}

enum SwallowObservation {
  NONE
  COUGHING
  GAGGING
  CHOKING
  WATERY_EYES
  MULTIPLE_SWALLOWS
  THROAT_CLEARING
}

enum MARStatus {
  ADMINISTERED
  REFUSED
  HELD
  LATE
  NOT_ADMINISTERED
}

enum StaffRole {
  SUPPORT_WORKER
  SUPERVISOR
  CLINICAL_LEAD
}

enum EntrySource {
  LIVE
  RESTORED_APPROVED
  SYNTHETIC_QA
  AUDIT_RECOVERY
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CANDIDATE_CREATED
  CANDIDATE_APPROVED
  CANDIDATE_REJECTED
  LEDGER_WRITTEN
}

model Participant {
  id                    String  @id @default(uuid())
  externalReference     String? @unique
  fullName              String
  defaultFoodTexture    Int
  defaultFluidThickness Int

  mealLogs           MealLog[]
  marLogs            MARLog[]
  sleepSettlingLogs  SleepSettlingLog[]
  behaviourSupportPlans BehaviourSupportPlan[]
  restrictivePracticeEvents RestrictivePracticeEvent[]
  bowelFluidLogs     BowelFluidLog[]
  shiftNotes         ShiftNote[]
  bglDiabetesLogs    BglDiabetesLog[]
  sleepSettlingQaLogs SleepSettlingQaLog[]
  bowelFluidQaLogs   BowelFluidQaLog[]
  hygieneLogs        HygieneLog[]
  communityAccessQaLogs CommunityAccessQaLog[]
  repositioningQaLogs RepositioningQaLog[]
  restorationBatches RestorationBatch[]
  mealCandidates     RestoredMealCandidate[]
  marCandidates      RestoredMARCandidate[]
  auditEvents        AuditEvent[]
  injectorButtons    InjectorButton[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id           String    @id @default(uuid())
  workerNumber String    @unique
  displayName  String
  role         StaffRole

  createdMealLogs             MealLog[]               @relation("MealCreatedBy")
  approvedMealLogs            MealLog[]               @relation("MealApprovedBy")
  createdMARLogs              MARLog[]                @relation("MARCreatedBy")
  approvedMARLogs             MARLog[]                @relation("MARApprovedBy")
  loggedSleepSettlingLogs     SleepSettlingLog[]      @relation("SleepSettlingLogsLoggedBy")
  loggedRestrictivePractices  RestrictivePracticeEvent[] @relation("RestrictivePracticesLoggedBy")
  loggedBowelFluidLogs        BowelFluidLog[]         @relation("BowelFluidLogsLoggedBy")
  authoredShiftNotes          ShiftNote[]             @relation("ShiftNotesAuthoredBy")
  bglDiabetesLogs             BglDiabetesLog[]        @relation("BglDiabetesLoggedBy")
  sleepSettlingQaLogs         SleepSettlingQaLog[]    @relation("SleepSettlingQaLoggedBy")
  bowelFluidQaLogs            BowelFluidQaLog[]       @relation("BowelFluidQaLoggedBy")
  hygieneLogs                 HygieneLog[]            @relation("HygieneLoggedBy")
  communityAccessQaLogs       CommunityAccessQaLog[]  @relation("CommunityAccessQaLoggedBy")
  repositioningQaLogs         RepositioningQaLog[]    @relation("RepositioningQaLoggedBy")
  requestedRestorationBatches RestorationBatch[]      @relation("BatchRequestedBy")
  reviewedRestorationBatches  RestorationBatch[]      @relation("BatchReviewedBy")
  generatedMealCandidates     RestoredMealCandidate[] @relation("MealCandidateGeneratedBy")
  reviewedMealCandidates      RestoredMealCandidate[] @relation("MealCandidateReviewedBy")
  generatedMARCandidates      RestoredMARCandidate[]  @relation("MARCandidateGeneratedBy")
  reviewedMARCandidates       RestoredMARCandidate[]  @relation("MARCandidateReviewedBy")
  auditEvents                 AuditEvent[]
  injectorButtons             InjectorButton[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestorationBatch {
  id                 String          @id @default(uuid())
  participantId      String
  participant        Participant     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  requestedByStaffId String
  requestedByStaff   Staff           @relation("BatchRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: Restrict)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?          @relation("BatchReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reason             String
  recoveryStart      DateTime
  recoveryEnd        DateTime
  status             CandidateStatus @default(PENDING)

  mealCandidates RestoredMealCandidate[]
  marCandidates  RestoredMARCandidate[]
  mealLogs       MealLog[]
  marLogs        MARLog[]

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([participantId, recoveryStart, recoveryEnd])
  @@index([status, createdAt])
}

model RestoredMealCandidate {
  id                     String               @id @default(uuid())
  restorationBatchId     String
  restorationBatch       RestorationBatch     @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId     String
  generatedByStaff       Staff                @relation("MealCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  status                 CandidateStatus      @default(PENDING)
  reviewedByStaffId      String?
  reviewedByStaff        Staff?               @relation("MealCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment          String?
  reviewedAt             DateTime?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([status, createdAt])
}

model RestoredMARCandidate {
  id                 String           @id @default(uuid())
  restorationBatchId String
  restorationBatch   RestorationBatch @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId String
  generatedByStaff   Staff            @relation("MARCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  statusComment      String?
  statusReview       CandidateStatus  @default(PENDING)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?           @relation("MARCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment      String?
  reviewedAt         DateTime?
  provenanceHash     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([statusReview, createdAt])
}

model MealLog {
  id                     String               @id @default(uuid())
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId       String
  createdByStaff         Staff                @relation("MealCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId      String?
  approvedByStaff        Staff?               @relation("MealApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId     String?
  restorationBatch       RestorationBatch?    @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source                 EntrySource          @default(LIVE)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([source, timestamp])
}

model MARLog {
  id                 String            @id @default(uuid())
  participantId      String
  participant        Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId   String
  createdByStaff     Staff             @relation("MARCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId  String?
  approvedByStaff    Staff?            @relation("MARApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId String?
  restorationBatch   RestorationBatch? @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source             EntrySource       @default(LIVE)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  provenanceHash     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([source, status, scheduledAdminTime])
}

enum SleepStatus {
  ASLEEP
  AWAKE
  AGITATED
}

enum BowelFluidType {
  BOWEL
  FLUID_IN
  FLUID_OUT
}

enum ShiftNoteCategory {
  ROUTINE
  ESCALATION
  INCIDENT_FOLLOWUP
  CLINICAL_HANDOVER
}

enum RestrictivePracticeType {
  CHEMICAL
  PHYSICAL
  MECHANICAL
  ENVIRONMENTAL
}

enum DataSource {
  SYNTHETIC_QA
  PRODUCTION
}

enum QaSeverity {
  NONE
  INFO
  WARN
  ERROR
  CRITICAL
}

enum FastingStatus {
  FASTING
  NON_FASTING
  UNKNOWN
}

enum QaSleepStatus {
  ASLEEP
  AWAKE
  AGITATED
  OUT_OF_BED
}

enum SleepIntervention {
  NONE
  VERBAL_PROMPT
  REDIRECTION
  CPAP_CHECK
  CONTINENCE_AID_CHANGE
  COMFORT_MEASURES
  OTHER
}

enum BristolScale {
  S1
  S2
  S3
  S4
  S5
  S6
  S7
}

enum StoolSize {
  SMALL
  MEDIUM
  LARGE
}

enum CompletionStatus {
  COMPLETED
  PARTIAL
  REFUSED
  NOT_APPLICABLE
  UNKNOWN
}

enum CommunityPurpose {
  SOCIAL
  MEDICAL
  CAPACITY_BUILDING
  OTHER
}

enum TransportMethod {
  WALK
  PUBLIC_TRANSPORT
  TAXI_RIDESHARE
  PROVIDER_VEHICLE
  PRIVATE_VEHICLE
  OTHER
}

enum RepositionPosition {
  LEFT_SIDE
  RIGHT_SIDE
  SUPINE
  PRONE
  SEATED
  TILT_IN_SPACE
  OTHER
}

enum SkinCheckOutcome {
  INTACT
  REDNESS
  BREAKDOWN
  PAIN
  REQUIRES_ESCALATION
  UNKNOWN
  OTHER
}

model SleepSettlingLog {
  id              String      @id @default(uuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff   Staff       @relation("SleepSettlingLogsLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  checkTime       DateTime
  status          SleepStatus?
  intervention    String?
  source          EntrySource @default(LIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([participantId, checkTime])
  @@index([loggedByStaffId, checkTime])
  @@index([source])
}

model BehaviourSupportPlan {
  id                        String                     @id @default(uuid())
  participantId             String
  participant               Participant                @relation(fields: [participantId], references: [id], onDelete: Restrict)
  activeFrom                DateTime
  activeTo                  DateTime
  version                   Int                        @default(1)
  approvedBy                String?
  notes                     String?
  source                    EntrySource                @default(LIVE)
  restrictivePracticeEvents RestrictivePracticeEvent[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([participantId, activeFrom, activeTo])
  @@index([createdAt])
}

model RestrictivePracticeEvent {
  id                   String                    @id @default(uuid())
  participantId        String
  participant          Participant               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId      String
  loggedByStaff        Staff                     @relation("RestrictivePracticesLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  timestamp            DateTime
  type                 RestrictivePracticeType
  reason               String
  durationMin          Int?
  bspVersionId         String?
  behaviourSupportPlan BehaviourSupportPlan?     @relation(fields: [bspVersionId], references: [id], onDelete: SetNull)
  incidentId           String?
  relatedMarLogId      String?
  source               EntrySource               @default(LIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([participantId, timestamp])
  @@index([bspVersionId])
  @@index([timestamp])
  @@index([source])
}

model BowelFluidLog {
  id              String         @id @default(uuid())
  participantId   String
  participant     Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff   Staff          @relation("BowelFluidLogsLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  timestamp       DateTime
  type            BowelFluidType
  volumeMl        Int?
  bristolScale    Int?
  notes           String?
  source          EntrySource    @default(LIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([participantId, timestamp])
  @@index([type, timestamp])
  @@index([source])
}

model ShiftNote {
  id                      String            @id @default(uuid())
  participantId           String
  participant             Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authoredByStaffId       String
  authoredByStaff         Staff             @relation("ShiftNotesAuthoredBy", fields: [authoredByStaffId], references: [id], onDelete: Restrict)
  category                ShiftNoteCategory
  note                    String
  linkedPersonalCareLogId String?
  linkedIncidentId        String?
  linkedBglLogId          String?
  linkedBowelFluidLogId   String?
  source                  EntrySource       @default(LIVE)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([participantId, createdAt])
  @@index([category, createdAt])
  @@index([source])
}

model BglDiabetesLog {
  id                  String        @id @default(uuid())
  source              DataSource    @default(SYNTHETIC_QA)
  participantId       String
  participant         Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId             String
  staff               Staff         @relation("BglDiabetesLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate           String
  loggedAt            DateTime
  bglReadingMmolL     Float?
  fastingStatus       FastingStatus @default(UNKNOWN)
  insulinAdministered Boolean       @default(false)
  insulinMarRefId     String?
  actionTaken         String?
  qaSeverity          QaSeverity    @default(NONE)
  qaAnomalyFlag       Boolean       @default(false)
  qaMeta              Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([participantId, loggedAt])
  @@index([staffId, loggedAt])
  @@index([localDate])
  @@index([source])
}

model SleepSettlingQaLog {
  id            String            @id @default(uuid())
  source        DataSource        @default(SYNTHETIC_QA)
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId       String
  staff         Staff             @relation("SleepSettlingQaLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate     String
  checkedAt     DateTime
  status        QaSleepStatus
  intervention  SleepIntervention @default(NONE)
  notes         String?
  qaSeverity    QaSeverity        @default(NONE)
  qaAnomalyFlag Boolean           @default(false)
  qaMeta        Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([participantId, checkedAt])
  @@index([staffId, checkedAt])
  @@index([localDate])
  @@index([source])
}

model BowelFluidQaLog {
  id                    String      @id @default(uuid())
  source                DataSource  @default(SYNTHETIC_QA)
  participantId         String
  participant           Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId               String
  staff                 Staff       @relation("BowelFluidQaLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate             String
  loggedAt              DateTime
  hadBowelMotion        Boolean     @default(false)
  bristolScale          BristolScale?
  stoolSize             StoolSize?
  fluidIntakeDeltaMl    Int         @default(0)
  fluidOutputDeltaMl    Int         @default(0)
  cumulativeIntakeMl    Int         @default(0)
  cumulativeOutputMl    Int         @default(0)
  netBalanceMl          Int         @default(0)
  qaSeverity            QaSeverity  @default(NONE)
  qaAnomalyFlag         Boolean     @default(false)
  qaMeta                Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([participantId, loggedAt])
  @@index([staffId, loggedAt])
  @@index([localDate])
  @@index([source])
}

model HygieneLog {
  id                   String           @id @default(uuid())
  source               DataSource       @default(SYNTHETIC_QA)
  participantId        String
  participant          Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId              String
  staff                Staff            @relation("HygieneLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate            String
  loggedAt             DateTime
  showerStatus         CompletionStatus @default(UNKNOWN)
  oralCareStatus       CompletionStatus @default(UNKNOWN)
  groomingStatus       CompletionStatus @default(UNKNOWN)
  continenceCareStatus CompletionStatus @default(UNKNOWN)
  skinIntegrityChecked CompletionStatus @default(UNKNOWN)
  refusalReason        String?
  alternativeMethod    String?
  notes                String?
  qaSeverity           QaSeverity       @default(NONE)
  qaAnomalyFlag        Boolean          @default(false)
  qaMeta               Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([participantId, loggedAt])
  @@index([staffId, loggedAt])
  @@index([localDate])
  @@index([source])
}

model CommunityAccessQaLog {
  id              String           @id @default(uuid())
  source          DataSource       @default(SYNTHETIC_QA)
  participantId   String
  participant     Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId         String
  staff           Staff            @relation("CommunityAccessQaLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate       String
  departedAt      DateTime
  returnedAt      DateTime?
  destination     String
  purpose         CommunityPurpose
  transportMethod TransportMethod
  odometerStart   Int?
  odometerEnd     Int?
  notes           String?
  qaSeverity      QaSeverity       @default(NONE)
  qaAnomalyFlag   Boolean          @default(false)
  qaMeta          Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([participantId, departedAt])
  @@index([staffId, departedAt])
  @@index([localDate])
  @@index([source])
}

model RepositioningQaLog {
  id               String            @id @default(uuid())
  source           DataSource        @default(SYNTHETIC_QA)
  participantId    String
  participant      Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffId          String
  staff            Staff             @relation("RepositioningQaLoggedBy", fields: [staffId], references: [id], onDelete: Restrict)
  localDate        String
  turnedAt         DateTime
  position         RepositionPosition
  skinCheckOutcome SkinCheckOutcome  @default(UNKNOWN)
  notes            String?
  planIntervalMin  Int?
  qaSeverity       QaSeverity        @default(NONE)
  qaAnomalyFlag    Boolean           @default(false)
  qaMeta           Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([participantId, turnedAt])
  @@index([staffId, turnedAt])
  @@index([localDate])
  @@index([source])
}

model AuditEvent {
  id            String       @id @default(uuid())
  actorStaffId  String
  actorStaff    Staff        @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  action        AuditAction
  entityType    String
  entityId      String
  payloadHash   String
  previousHash  String?
  createdAt     DateTime     @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([participantId, createdAt])
}

model GapReport {
  id              String   @id @default(uuid())
  from            DateTime
  to              DateTime
  scope           String?  // meal | mar | audit | batch
  kpiMetrics      Json     // { completionRate, errorRate, avgProcessingTime }
  aiSummary       String
  recommendations Json     // String[]
  geminiModel     String   @default("gemini-2.0-flash")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // Optional: for auto-cleanup of old reports

  @@index([createdAt])
  @@index([from, to])
  @@index([expiresAt])
}

enum RangePreset {
  day
  week_plus
  month_plus
}

model InjectorButton {
  id            String      @id @default(uuid())
  label         String
  participantId String
  staffId       String
  enabled       Boolean     @default(true)
  rangePreset   RangePreset @default(day)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  participant   Participant @relation(fields: [participantId], references: [id])
  staff         Staff       @relation(fields: [staffId], references: [id])

  @@index([enabled, sortOrder])
}
