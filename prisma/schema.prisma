datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum AmountEaten {
  ZERO
  TWENTY_FIVE
  FIFTY
  SEVENTY_FIVE
  ONE_HUNDRED
  REFUSED
}

enum SwallowObservation {
  NONE
  COUGHING
  GAGGING
  CHOKING
  WATERY_EYES
  MULTIPLE_SWALLOWS
  THROAT_CLEARING
}

enum MARStatus {
  ADMINISTERED
  REFUSED
  HELD
  LATE
  NOT_ADMINISTERED
}

enum StaffRole {
  SUPPORT_WORKER
  SUPERVISOR
  CLINICAL_LEAD
}

enum EntrySource {
  LIVE
  RESTORED_APPROVED
  SYNTHETIC_QA
  AUDIT_RECOVERY
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  CANDIDATE_CREATED
  CANDIDATE_APPROVED
  CANDIDATE_REJECTED
  LEDGER_WRITTEN
}

model Participant {
  id                    String  @id @default(uuid())
  externalReference     String? @unique
  fullName              String
  defaultFoodTexture    Int
  defaultFluidThickness Int

  mealLogs           MealLog[]
  marLogs            MARLog[]
  sleepSettlingLogs  SleepSettlingLog[]
  behaviourSupportPlans BehaviourSupportPlan[]
  restrictivePracticeEvents RestrictivePracticeEvent[]
  bowelFluidLogs     BowelFluidLog[]
  shiftNotes         ShiftNote[]
  restorationBatches RestorationBatch[]
  mealCandidates     RestoredMealCandidate[]
  marCandidates      RestoredMARCandidate[]
  auditEvents        AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id           String    @id @default(uuid())
  workerNumber String    @unique
  displayName  String
  role         StaffRole

  createdMealLogs             MealLog[]               @relation("MealCreatedBy")
  approvedMealLogs            MealLog[]               @relation("MealApprovedBy")
  createdMARLogs              MARLog[]                @relation("MARCreatedBy")
  approvedMARLogs             MARLog[]                @relation("MARApprovedBy")
  loggedSleepSettlingLogs     SleepSettlingLog[]      @relation("SleepSettlingLogsLoggedBy")
  loggedRestrictivePractices  RestrictivePracticeEvent[] @relation("RestrictivePracticesLoggedBy")
  loggedBowelFluidLogs        BowelFluidLog[]         @relation("BowelFluidLogsLoggedBy")
  authoredShiftNotes          ShiftNote[]             @relation("ShiftNotesAuthoredBy")
  requestedRestorationBatches RestorationBatch[]      @relation("BatchRequestedBy")
  reviewedRestorationBatches  RestorationBatch[]      @relation("BatchReviewedBy")
  generatedMealCandidates     RestoredMealCandidate[] @relation("MealCandidateGeneratedBy")
  reviewedMealCandidates      RestoredMealCandidate[] @relation("MealCandidateReviewedBy")
  generatedMARCandidates      RestoredMARCandidate[]  @relation("MARCandidateGeneratedBy")
  reviewedMARCandidates       RestoredMARCandidate[]  @relation("MARCandidateReviewedBy")
  auditEvents                 AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestorationBatch {
  id                 String          @id @default(uuid())
  participantId      String
  participant        Participant     @relation(fields: [participantId], references: [id], onDelete: Restrict)
  requestedByStaffId String
  requestedByStaff   Staff           @relation("BatchRequestedBy", fields: [requestedByStaffId], references: [id], onDelete: Restrict)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?          @relation("BatchReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reason             String
  recoveryStart      DateTime
  recoveryEnd        DateTime
  status             CandidateStatus @default(PENDING)

  mealCandidates RestoredMealCandidate[]
  marCandidates  RestoredMARCandidate[]
  mealLogs       MealLog[]
  marLogs        MARLog[]

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([participantId, recoveryStart, recoveryEnd])
  @@index([status, createdAt])
}

model RestoredMealCandidate {
  id                     String               @id @default(uuid())
  restorationBatchId     String
  restorationBatch       RestorationBatch     @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId     String
  generatedByStaff       Staff                @relation("MealCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  status                 CandidateStatus      @default(PENDING)
  reviewedByStaffId      String?
  reviewedByStaff        Staff?               @relation("MealCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment          String?
  reviewedAt             DateTime?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([status, createdAt])
}

model RestoredMARCandidate {
  id                 String           @id @default(uuid())
  restorationBatchId String
  restorationBatch   RestorationBatch @relation(fields: [restorationBatchId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Restrict)
  generatedByStaffId String
  generatedByStaff   Staff            @relation("MARCandidateGeneratedBy", fields: [generatedByStaffId], references: [id], onDelete: Restrict)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  statusComment      String?
  statusReview       CandidateStatus  @default(PENDING)
  reviewedByStaffId  String?
  reviewedByStaff    Staff?           @relation("MARCandidateReviewedBy", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewComment      String?
  reviewedAt         DateTime?
  provenanceHash     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([statusReview, createdAt])
}

model MealLog {
  id                     String               @id @default(uuid())
  participantId          String
  participant            Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId       String
  createdByStaff         Staff                @relation("MealCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId      String?
  approvedByStaff        Staff?               @relation("MealApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId     String?
  restorationBatch       RestorationBatch?    @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source                 EntrySource          @default(LIVE)
  timestamp              DateTime
  mealType               MealType
  foodTexture            Int
  fluidThickness         Int
  volumeMl               Int
  amountEaten            AmountEaten
  swallowingObservations SwallowObservation[]
  deviationReason        String?
  incidentReference      String?
  provenanceHash         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, timestamp])
  @@index([source, timestamp])
}

model MARLog {
  id                 String            @id @default(uuid())
  participantId      String
  participant        Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdByStaffId   String
  createdByStaff     Staff             @relation("MARCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  approvedByStaffId  String?
  approvedByStaff    Staff?            @relation("MARApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  restorationBatchId String?
  restorationBatch   RestorationBatch? @relation(fields: [restorationBatchId], references: [id], onDelete: SetNull)
  source             EntrySource       @default(LIVE)
  scheduledAdminTime DateTime
  actualAdminTime    DateTime
  medicationName     String
  dosage             String
  route              String
  status             MARStatus
  omissionReason     String?
  provenanceHash     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, scheduledAdminTime])
  @@index([source, status, scheduledAdminTime])
}

enum SleepStatus {
  ASLEEP
  AWAKE
  AGITATED
}

enum BowelFluidType {
  BOWEL
  FLUID_IN
  FLUID_OUT
}

enum ShiftNoteCategory {
  ROUTINE
  ESCALATION
  INCIDENT_FOLLOWUP
  CLINICAL_HANDOVER
}

enum RestrictivePracticeType {
  CHEMICAL
  PHYSICAL
  MECHANICAL
  ENVIRONMENTAL
}

model SleepSettlingLog {
  id              String      @id @default(uuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff   Staff       @relation("SleepSettlingLogsLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  checkTime       DateTime
  status          SleepStatus?
  intervention    String?
  source          EntrySource @default(LIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([participantId, checkTime])
  @@index([loggedByStaffId, checkTime])
  @@index([source])
}

model BehaviourSupportPlan {
  id                        String                     @id @default(uuid())
  participantId             String
  participant               Participant                @relation(fields: [participantId], references: [id], onDelete: Restrict)
  activeFrom                DateTime
  activeTo                  DateTime
  version                   Int                        @default(1)
  approvedBy                String?
  notes                     String?
  source                    EntrySource                @default(LIVE)
  restrictivePracticeEvents RestrictivePracticeEvent[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([participantId, activeFrom, activeTo])
  @@index([createdAt])
}

model RestrictivePracticeEvent {
  id                   String                    @id @default(uuid())
  participantId        String
  participant          Participant               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId      String
  loggedByStaff        Staff                     @relation("RestrictivePracticesLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  timestamp            DateTime
  type                 RestrictivePracticeType
  reason               String
  durationMin          Int?
  bspVersionId         String?
  behaviourSupportPlan BehaviourSupportPlan?     @relation(fields: [bspVersionId], references: [id], onDelete: SetNull)
  incidentId           String?
  relatedMarLogId      String?
  source               EntrySource               @default(LIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([participantId, timestamp])
  @@index([bspVersionId])
  @@index([timestamp])
  @@index([source])
}

model BowelFluidLog {
  id              String         @id @default(uuid())
  participantId   String
  participant     Participant    @relation(fields: [participantId], references: [id], onDelete: Restrict)
  loggedByStaffId String
  loggedByStaff   Staff          @relation("BowelFluidLogsLoggedBy", fields: [loggedByStaffId], references: [id], onDelete: Restrict)
  timestamp       DateTime
  type            BowelFluidType
  volumeMl        Int?
  bristolScale    Int?
  notes           String?
  source          EntrySource    @default(LIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([participantId, timestamp])
  @@index([type, timestamp])
  @@index([source])
}

model ShiftNote {
  id                      String            @id @default(uuid())
  participantId           String
  participant             Participant       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  authoredByStaffId       String
  authoredByStaff         Staff             @relation("ShiftNotesAuthoredBy", fields: [authoredByStaffId], references: [id], onDelete: Restrict)
  category                ShiftNoteCategory
  note                    String
  linkedPersonalCareLogId String?
  linkedIncidentId        String?
  linkedBglLogId          String?
  linkedBowelFluidLogId   String?
  source                  EntrySource       @default(LIVE)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([participantId, createdAt])
  @@index([category, createdAt])
  @@index([source])
}

model AuditEvent {
  id            String       @id @default(uuid())
  actorStaffId  String
  actorStaff    Staff        @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  action        AuditAction
  entityType    String
  entityId      String
  payloadHash   String
  previousHash  String?
  createdAt     DateTime     @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([participantId, createdAt])
}

model GapReport {
  id              String   @id @default(uuid())
  from            DateTime
  to              DateTime
  scope           String?  // meal | mar | audit | batch
  kpiMetrics      Json     // { completionRate, errorRate, avgProcessingTime }
  aiSummary       String
  recommendations Json     // String[]
  geminiModel     String   @default("gemini-2.0-flash")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // Optional: for auto-cleanup of old reports

  @@index([createdAt])
  @@index([from, to])
  @@index([expiresAt])
}
